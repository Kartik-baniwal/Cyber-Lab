# RangeForge Custom Kali Linux Workstation Image
# Official Kali Linux Rolling with Offensive Security Toolkit
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# Bootstrap HTTPS and retry transient mirror failures.
RUN printf 'Acquire::Retries "5";\n' > /etc/apt/apt.conf.d/80retries && \
    apt-get update && apt-get install -y ca-certificates && \
    find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
      -exec sed -i 's|http://http.kali.org/kali|https://kali.download/kali|g' {} + && \
    rm -f /etc/apt/apt.conf.d/docker-clean

# Refresh Rolling and install the standard Kali toolset, including GUI tools.
# Keep recommends: the full distribution depends on them for its tool collections.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get -y full-upgrade && \
    apt-get install -y kali-linux-default kali-desktop-xfce \
      metasploit-framework nmap wireshark burpsuite sqlmap hydra john hashcat \
      aircrack-ng gobuster seclists wordlists exploitdb \
      sudo net-tools iproute2 iputils-ping dnsutils python3 util-linux && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Report installed packages rather than a simulated tool inventory.
RUN printf '#!/bin/sh\ndpkg-query -W kali-linux-default kali-desktop-xfce\ncommand -v nmap msfconsole sqlmap hydra john wireshark gobuster\n' > /usr/local/bin/kali-tools && \
    chmod +x /usr/local/bin/kali-tools

# 2. Setup root environment and learner user
RUN mkdir -p /root/lab /root/wordlists /root/exploits && \
    useradd -m -s /bin/bash -u 1000 learner && \
    echo "learner ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/learner && \
    chmod 0440 /etc/sudoers.d/learner

# 3. Configure realistic bash environment & prompt
RUN echo 'export PS1="\[\033[01;31m\]root@kali\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# "' >> /root/.bashrc && \
    echo 'alias ll="ls -la"' >> /root/.bashrc

# 4. Create sample target mapping file
RUN echo "# RangeForge Lab Targets\n10.10.0.10  target.lab  (Vulnerable Web App)" > /root/targets.txt

WORKDIR /root
CMD ["sleep", "infinity"]
